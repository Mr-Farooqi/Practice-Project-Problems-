<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bharat Mobile Center</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#0E1420;
    --navy-deep:#090D15;
    --panel:#161F2E;
    --panel-edge:#232F44;
    --off-white:#F4F1E8;
    --muted:#9AA6B8;
    --saffron:#FF7A29;
    --saffron-dim:#FF7A2922;
    --whatsapp:#2FD180;
    --insta1:#FEDA75;
    --insta2:#D62976;
    --insta3:#962FBF;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:
      radial-gradient(ellipse 900px 500px at 15% -10%, #1A2A4A55, transparent 60%),
      radial-gradient(ellipse 700px 500px at 100% 10%, #FF7A2914, transparent 60%),
      var(--navy);
    color:var(--off-white);
    font-family:'Inter', sans-serif;
    min-height:100vh;
    overflow-x:hidden;
  }
  /* faint circuit-trace background pattern */
  .traces{
    position:fixed; inset:0; z-index:0; opacity:.16; pointer-events:none;
    background-image:
      linear-gradient(var(--panel-edge) 1px, transparent 1px),
      linear-gradient(90deg, var(--panel-edge) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: radial-gradient(ellipse 100% 70% at 50% 20%, black 10%, transparent 75%);
  }

  .wrap{position:relative; z-index:1; max-width:520px; margin:0 auto; padding:36px 22px 40px;}

  /* ---------- Header ---------- */
  header{text-align:center; padding-top:8px;}
  .eyebrow{
    font-size:12px; letter-spacing:.22em; text-transform:uppercase;
    color:var(--saffron); font-weight:600; margin-bottom:14px;
    display:flex; align-items:center; justify-content:center; gap:10px;
  }
  .eyebrow::before,.eyebrow::after{content:"";width:22px;height:1px;background:var(--saffron);opacity:.5;}

  h1{
    font-family:'Poppins',sans-serif; font-weight:800;
    font-size:clamp(32px,9vw,44px); line-height:1.08; letter-spacing:-0.02em;
  }
  h1 .accent{color:var(--saffron);}
  .tagline{
    margin-top:12px; color:var(--muted); font-size:15px; font-weight:500;
    letter-spacing:.01em;
  }

  /* ---------- Phone signature element ---------- */
  .phone-stage{
    display:flex; justify-content:center; margin:34px 0 30px;
  }
  .phone{
    width:150px; height:290px;
    background:linear-gradient(160deg,#1C2740,#101828);
    border:2px solid var(--panel-edge);
    border-radius:30px;
    position:relative;
    box-shadow: 0 0 0 6px var(--navy-deep), 0 20px 50px -18px #000000aa, inset 0 0 24px #00000055;
  }
  .phone::before{ /* notch */
    content:""; position:absolute; top:14px; left:50%; transform:translateX(-50%);
    width:38px; height:5px; border-radius:4px; background:#0A0F18;
  }
  .phone-screen{
    position:absolute; inset:26px 10px 16px;
    border-radius:18px;
    background:radial-gradient(circle at 50% 30%, #24314C, #0E1522 75%);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    overflow:hidden;
  }
  .phone-screen .glow{
    position:absolute; width:120px; height:120px; border-radius:50%;
    background:var(--saffron); filter:blur(45px); opacity:.35; top:-20px;
    animation:pulse 3.2s ease-in-out infinite;
  }
  @keyframes pulse{0%,100%{opacity:.25; transform:scale(1);}50%{opacity:.5; transform:scale(1.15);}}
  .bmc-mark{
    font-family:'Poppins',sans-serif; font-weight:800; font-size:26px;
    color:var(--off-white); z-index:1; letter-spacing:-0.03em;
  }
  .bmc-mark span{color:var(--saffron);}
  .phone-screen small{
    z-index:1; color:var(--muted); font-size:9px; letter-spacing:.15em; margin-top:4px; text-transform:uppercase;
  }

  /* ---------- Action grid (home-screen style buttons) ---------- */
  .section-label{
    font-size:11px; letter-spacing:.18em; text-transform:uppercase;
    color:var(--muted); font-weight:600; margin:0 0 14px 4px;
  }
  .actions{
    display:flex; flex-direction:column; gap:14px; margin-bottom:34px;
  }
  .action-btn{
    display:flex; align-items:center; gap:16px;
    background:var(--panel);
    border:1px solid var(--panel-edge);
    border-radius:16px;
    padding:16px 18px;
    text-decoration:none;
    color:var(--off-white);
    transition:transform .18s ease, border-color .18s ease, background .18s ease;
    position:relative;
    overflow:hidden;
  }
  .action-btn:active{transform:scale(.97);}
  .action-btn:hover{border-color:#3A4A66;}
  .icon-box{
    width:46px; height:46px; border-radius:13px;
    display:flex; align-items:center; justify-content:center;
    flex-shrink:0;
  }
  .icon-box svg{width:24px; height:24px;}
  .btn-text{display:flex; flex-direction:column; flex:1; text-align:left;}
  .btn-title{font-weight:600; font-size:15.5px;}
  .btn-sub{font-size:12.5px; color:var(--muted); margin-top:2px;}
  .chev{color:var(--muted); flex-shrink:0;}

  .icon-whatsapp{background:#2FD18022;}
  .icon-whatsapp svg{fill:var(--whatsapp);}
  .icon-call{background:var(--saffron-dim);}
  .icon-call svg{fill:var(--saffron);}
  .icon-insta{background:linear-gradient(135deg,#FEDA7533,#D6297633,#962FBF33);}
  .icon-insta svg{fill:#F177B8;}

  .action-btn.whatsapp:hover{border-color:#2FD18055;}
  .action-btn.call:hover{border-color:#FF7A2955;}
  .action-btn.insta:hover{border-color:#D6297655;}

  /* ---------- Info card ---------- */
  .info-card{
    background:var(--panel);
    border:1px solid var(--panel-edge);
    border-radius:16px;
    padding:18px 20px;
    margin-bottom:28px;
  }
  .info-row{
    display:flex; justify-content:space-between; align-items:center;
    padding:9px 0;
    font-size:13.5px;
  }
  .info-row + .info-row{border-top:1px solid var(--panel-edge);}
  .info-row .label{color:var(--muted);}
  .info-row .value{font-weight:600;}
  .value.open{color:var(--whatsapp);}

  /* ---------- Footer ---------- */
  footer{text-align:center; padding-top:6px;}
  footer .fname{
    font-family:'Poppins',sans-serif; font-weight:700; font-size:14px; color:var(--off-white);
  }
  footer .fnote{font-size:11.5px; color:var(--muted); margin-top:4px;}

  @media(prefers-reduced-motion: reduce){
    .phone-screen .glow{animation:none;}
  }
</style>
</head>
<body>

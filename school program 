            line-height: 1.8;
            color: #d1d5db;
            margin-bottom: 30px;
        }

        .contact-email {
            font-size: 24px;
            color: #a78bfa;
            margin: 20px 0;
            text-decoration: none;
            display: inline-block;
        }

        .social-icons {
            display: flex;
            gap: 15px;
            margin-top: 40px;
            justify-content: center;
        }

        .social-icon {

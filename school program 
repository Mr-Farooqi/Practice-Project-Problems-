        }

        .overview-content p {
            font-size: 18px;
            line-height: 1.8;
            color: #d1d5db;
            margin-bottom: 20px;
        }

        .stats {
            display: flex;
            justify-content: space-around;
            max-width: 1000px;
            width: 100%;
            margin-top: 50px;
            flex-wrap: wrap;
            gap: 30px;
        }

        .stat-item {
